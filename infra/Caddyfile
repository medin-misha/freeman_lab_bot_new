{
    acme_ca https://acme.zerossl.com/v2/DV90
    acme_eab {
        key_id {$ZEROSSL_KID}
        mac_key {$ZEROSSL_MAC_KEY}
    }
}

https://{$CADDY_SITE_ADDRESS} {
    # API запросы → backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Grafana — просмотр логов
    handle /logs* {
        reverse_proxy grafana:3000
    }

    # Админ-панель
    handle /admin* {
        reverse_proxy admin-mini-app:80
    }

    # Всё остальное → фронтенд
    handle {
        reverse_proxy core-mini-app:80
    }
}

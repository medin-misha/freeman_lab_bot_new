# Root Docker Compose variables
# Copy to .env in the repository root before running docker compose.

# Local Telegram Bot API
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_BOT_API_PORT=8081

# Backend host port
BACKEND_PORT=8000
CORE_MINI_APP_API_URL=/api

# Caddy
# For local runs you can keep localhost.
# For server deployment without a domain set this to the server public IP.
CADDY_SITE_ADDRESS=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ZeroSSL — required for HTTPS on a public IP (without a domain).
# Register at https://app.zerossl.com → Developer → EAB Credentials → Generate.
# Not needed for local runs (CADDY_SITE_ADDRESS=localhost).
ZEROSSL_KID=your_zerossl_key_id
ZEROSSL_MAC_KEY=your_zerossl_mac_key

# Postgres
POSTGRES_DB=fastapi_template
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=app
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=backend
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

